{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Demo Completa (API + UI)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["run_demo.py", "--no-browser"],
      "port": 8000
    },
    {
      "name": "API Uvicorn Direct (Fase 4 dev)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "main:app", "--host", "127.0.0.1", "--port", "8000", "--log-level", "warning"],
      "cwd": "PY",
      "port": 8000
    },
    {
      "name": "UI estática (só frontend)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8001", "--directory", "UI"],
      "port": 8001
    },
    {
      "name": "Testes — pytest suite completa (320 testes)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "pytest", "PY/tests/", "-v", "--tb=short"],
      "port": 0
    }
  ]
}
