# Motor Tributário Conect — Template de Variáveis de Ambiente
# Uso: cp env.template .env   e preencha os valores abaixo.
# NUNCA commite o .env com valores reais.

# ── Chaves de segurança (OBRIGATÓRIO) ────────────────────────────────────────

# Chave JWT — mínimo 32 chars aleatórios
# Gerar: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Chave mestre de auditoria documental (AES-256-GCM + HKDF)
# PERDA DESTA CHAVE = PDFs antigos irrecuperáveis. Guardar em cofre (1Password/Bitwarden).
# Gerar: python -c "import secrets; print(secrets.token_hex(32))"
MOTOR_CONECT_MASTER_KEY=

# ── Claude Vision API ────────────────────────────────────────────────────────
# Necessário para extração de PDFs via POST /analise/pdf
# Obter em: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Banco de dados ───────────────────────────────────────────────────────────
# SQLite (padrão) — caminho relativo à pasta PY/
DATABASE_URL=sqlite:///motor_tributario.db

# ── Admin padrão (criado na primeira startup se tabela vazia) ────────────────
# Mínimo 8 chars, ao menos 1 número e 1 símbolo
DEFAULT_ADMIN_PASSWORD=

# ── Ambiente e logging ───────────────────────────────────────────────────────
# Valores aceitos: development | production | test
ENVIRONMENT=development
# Nível de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Formato: text (legível humano) | json (produção/Datadog/Loki)
LOG_FORMAT=text

# ── CORS (origens permitidas, separadas por vírgula) ─────────────────────────
# Em produção, substitua pelos domínios reais (ex: https://app.conect.com.br)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── Integrações externas (opcional) ─────────────────────────────────────────
# SIEG — API Key para download automático de XMLs NF-e/NF-Se
SIEG_API_KEY=

# Integra Contador — Certificado digital A1 para extração Gov.br
INTEGRA_CERT_PATH=
INTEGRA_CERT_PASSWORD=
